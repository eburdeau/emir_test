    <xs:complexType name="MatchingCriteria16__1">
        <xs:annotation>
            <xs:documentation source="Name" xml:lang="EN">MatchingCriteria16__1</xs:documentation>
            <xs:documentation source="Definition" xml:lang="EN">Provides details on loan and collateral matching criteria.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element maxOccurs="1" minOccurs="0" name="CtrPtyMtchgCrit" type="CounterpartyMatchingCriteria6__1">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">CounterpartyMatchingCriteria</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Compares information related to both sides of a counterparty.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="ValtnMtchgCrit" type="ValuationMatchingCriteria1">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">ValuationMatchingCriteria</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Compares information related to both sides of a contract valuation.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="CtrctMtchgCrit" type="ContractMatchingCriteria3__1">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">ContractMatchingCriteria</xs:documentation>
                    <xs:documentation source="Definition" xml:lang="EN">Compares information related to both sides of a contract.</xs:documentation>
                </xs:annotation>
            </xs:element>
